# Copy this file to .env and fill in your Naukri credentials.
# Never commit .env to version control.

NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_secure_password
NAUKRI_NO_OF_JOBS=25
NAUKRI_JOBS_BASE_URL=https://www.naukri.com/javascript-jobs
NAUKRI_JOB_KEYWORD=javascript
NAUKRI_JOB_AGE=1
NAUKRI_CTC_FILTERS=25to50,50to75,75to100,100to500
NAUKRI_JOB_MAX_PAGES=100
NAUKRI_JOB_RELEVANCE_MIN_PCT=80.0
NAUKRI_IS_EMAIL_REQUIRED=false
NAUKRI_LOGIN_URL=https://www.naukri.com/nlogin/login

# ---------------------------------------------------------------------------
# Global LLM provider (llm_provider/) — applies to EVERY module below (job engine
# classifiers, Resume Intelligence, Profile/Code Assistant, Stock Finder, RAG pages,
# Interview Simulator, Autonomous Application Agent). See docs/LLM_PROVIDER.md.
# ---------------------------------------------------------------------------

# openai (default) = hosted OpenAI with each module's *_MODEL settings below and
# OPENAI_API_KEY. ollama = local Ollama server; no OpenAI key needed.
LLM_PROVIDER=openai
# Embeddings (RAG pages, Code Assistant index, Stock Finder news search) follow
# LLM_PROVIDER unless set; e.g. keep them on openai while chat runs on ollama.
# EMBEDDING_PROVIDER=

OLLAMA_HOST=http://localhost:11434
# Serves every OpenAI model name used below unless OLLAMA_MODEL_MAP maps it.
OLLAMA_MODEL=qwen3:8b
# Optional per-model overrides, e.g. give critics a different model than answerers:
# OLLAMA_MODEL_MAP=gpt-4o=qwen3:14b,gpt-4.1=llama3.1:8b
# qwen3:8b cannot embed; needs its own `ollama pull nomic-embed-text`.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# qwen3 "thinking" is ~16x slower for the same classification; off by default.
OLLAMA_THINK=false
# Context window for job-engine / Resume Intelligence calls. Set OLLAMA_CONTEXT_LENGTH
# to the same value for the Ollama app itself (see docs) so other modules match.
OLLAMA_NUM_CTX=16384
# Seconds per call on Ollama (replaces the OpenAI timeouts; CPU inference is slow).
OLLAMA_TIMEOUT=300

# Hugging Face token for Interview Simulator TTS (Inference API + fal-ai).
# Use either name; the app reads both. Token needs access to Inference / providers you use.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# ---------------------------------------------------------------------------
# AI Job Discovery & Matching Engine (jobEngine/) — see docs/job_engine/
# CONFIGURATION.md for full details. Everything below has a sane default;
# only OPENAI_API_KEY (or LLM_PROVIDER=ollama) is required to get LLM matching.
# ---------------------------------------------------------------------------

# Reused if already set above for other modules; job_engine reads the same var.
# OPENAI_API_KEY=

JOB_ENGINE_OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
JOB_LLM_MAX_RETRIES=2
JOB_ENGINE_LLM_ENABLED=true
JOB_MATCH_PROMPT_VERSION=v1

# Optional LangSmith tracing (standard LangChain env vars; opt-in, unset by default)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=job-engine

JOB_BROWSER_HEADLESS=true
JOB_BROWSER_TIMEOUT=60000
JOB_BROWSER_NAV_TIMEOUT=45000
JOB_BROWSER_MAX_RETRIES=3
JOB_BROWSER_MAX_CONCURRENCY=3

JOB_MAX_SOURCES=10
JOB_MAX_JOBS_PER_SOURCE=100
JOB_MIN_MATCH_SCORE=70
# Parallelism: concurrent LLM calls, and LinkedIn tabs scraping results pages at once.
JOB_LLM_CONCURRENCY=12
LINKEDIN_MAX_TABS=3
# Worker processes for CPU-bound per-job work (default: min(4, CPUs); 0 = inline),
# used once a run has at least JOB_CPU_PARALLEL_MIN_JOBS jobs.
JOB_CPU_WORKERS=
JOB_CPU_PARALLEL_MIN_JOBS=40

# Worldwide-remote eligibility classification (badges/filters on the job pages).
JOB_WORLDWIDE_REMOTE_ENABLED=false
JOB_WORLDWIDE_LLM_REVIEW=true
JOB_WORLDWIDE_LLM_MAX_JOBS=25
# Also adds visa-sponsorship / remote-scope labels. false = country-restricted jobs are
# kept and labelled; true = rejected before LLM matching (unless they offer visa sponsorship).
JOB_REJECT_COUNTRY_RESTRICTED=false

# LLM match analyses are cached by job text + profile + matcher version, so a job's
# score stays the same across runs (even after removing it from saved jobs).
ANALYSIS_CACHE_MAX_AGE_HOURS=720
# Rejection analysis on the Applied Jobs page: runs only when a job is marked
# rejected (no stored analysis yet) or Re-evaluate is clicked; the result is stored.
# Candidate timezone / pay / job-type preferences: config/candidate_preferences.yaml
JOB_REJECTION_MODEL=gpt-4o

JOB_ENGINE_DRY_RUN=false
JOB_ENGINE_DEBUG=false

# MongoDB holds job-engine runs, saved jobs and the LinkedIn session cookies
# (collections job_engine_runs, saved_jobs, rejected_jobs, browser_sessions).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vai_hub
MONGODB_DB_NAME=vai_hub
# Rejected jobs are remembered this long, so later runs neither re-open nor re-score them.
REJECTED_JOBS_MAX_AGE_HOURS=168

# LinkedIn session cookies are kept in MongoDB. A session file from the
# pre-MongoDB version is imported once from this path (default
# history/job_engine/linkedin_storage_state.json).
# LINKEDIN_STORAGE_STATE_PATH=

# Scheduled job search, run by app.py itself (jobEngine/scheduler.py). A time
# missed while the app is down or busy is skipped until the next one.
JOB_CRON_ENABLED=true
JOB_CRON_SCHEDULE=0 0,6-23 * * *
JOB_CRON_MAX_RESULTS=5
JOB_CRON_TIMEZONE=Asia/Kolkata

# Email a job (once) when its match score is above JOB_MAIL_THRESHOLD_SCORE, after
# any search run, manual or scheduled (jobEngine/notifications/job_alerts.py).
# Unset threshold = no emails. Gmail needs an App Password, not the account password.
JOB_MAIL_THRESHOLD_SCORE=80
JOB_MAIL_TO=virenderfullstack@gmail.com
EMAIL_SENDER=
EMAIL_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# When a mailed job's posting lists an HR email, the email quotes the sentence with
# it and a "Create draft email" link (JOB_HR_DRAFT_URL/<saved key>). Opening the link
# runs the Autonomous Application Agent on the job description + profile and saves
# the application (resume attached) over IMAP in the EMAIL_SENDER mailbox's Drafts
# with the same EMAIL_PASSWORD; if Gmail refuses the login, the page offers a
# prefilled Gmail compose link instead.
# JOB_HR_DRAFT_URL=https://ai.ritishka.in/hr-draft
# IMAP_HOST=imap.gmail.com

# ---------------------------------------------------------------------------
# Resume Intelligence (resumeIntel/) — JD-specific resume gap analysis.
# Reuses OPENAI_API_KEY set above; only override below if needed.
# ---------------------------------------------------------------------------

RESUME_INTEL_OPENAI_MODEL=gpt-4o-mini
RESUME_INTEL_LLM_ENABLED=true
RESUME_INTEL_LLM_MAX_RETRIES=1
RESUME_INTEL_DEFAULT_RESUME_FILE=SeniorFullStackAIEngineer.pdf
RESUME_INTEL_MAX_UPLOAD_BYTES=5000000
RESUME_INTEL_MAX_RESUME_CHARS=20000
RESUME_INTEL_MAX_JD_CHARS=20000

# ---------------------------------------------------------------------------
# Profile Assistant (profile_assistant/) — profile-grounded chatbot with a
# critic agent. Reuses OPENAI_API_KEY. See profile_assistant/README.md.
# ---------------------------------------------------------------------------

# Must be two DIFFERENT models (startup fails if they are equal).
PA_ANSWER_MODEL=gpt-4o-mini
PA_CRITIC_MODEL=gpt-4o
PA_PROFILE_PATH=profile_assistant/data/profile.json
# Supplementary profile sources (comma-separated; .pdf/.json/.md/.txt). The primary
# profile wins when they contradict each other. Set empty to use only PA_PROFILE_PATH.
PA_EXTRA_PROFILE_PATHS=Profile/Profile.pdf
# Strip phone numbers and email addresses from all profile sources before the model sees them.
PA_REDACT_CONTACT_DETAILS=true
PA_MAX_REVISIONS=2
PA_REQUEST_TIMEOUT=30
PA_MAX_RETRIES=3
PA_URL_PREFIX=/profile-assistant
# Shared secret for POST {prefix}/api/reload-profile (X-Admin-Token header); unset = route disabled.
PA_ADMIN_TOKEN=
# Set to false to serve only the JSON API (no Gradio UI).
PA_UI_ENABLED=true

# ---------------------------------------------------------------------------
# Code Assistant (code_assistant/) — AI coding agent over a project folder.
# Reuses OPENAI_API_KEY. See code_assistant/README.md.
# ---------------------------------------------------------------------------

# REQUIRED: comma-separated folders the agent may open (a workspace must be inside one).
CA_WORKSPACE_ROOTS=D:/Projects
CA_ROUTER_MODEL=gpt-4o-mini
CA_CODER_MODEL=gpt-4o
CA_PLANNER_MODEL=gpt-4o
# Must differ from CA_CODER_MODEL (startup fails if they are equal).
CA_REVIEWER_MODEL=o3-mini
CA_FALLBACK_MODEL=gpt-4o-mini
CA_EMBEDDING_MODEL=text-embedding-3-small
CA_MAX_AGENT_STEPS=15
CA_MAX_FIX_ATTEMPTS=3
CA_MAX_LLM_CALLS=40
CA_MAX_TOKENS_REQUEST=200000
CA_CONTEXT_TOKENS=60000
CA_COMMAND_TIMEOUT=120
CA_COMMAND_ALLOWLIST=pytest,python -m pytest,ruff,flake8,mypy,npm test
# Run verify commands inside `docker run --network none` (needs Docker).
CA_USE_DOCKER=false
CA_DOCKER_IMAGE=python:3.12-slim
CA_URL_PREFIX=/code-assistant
# Index new workspaces automatically (embeddings cost a little); re-index after applied changes.
CA_AUTO_INDEX=true
# Ask the user to approve the plan before executing large tasks.
CA_REQUIRE_PLAN_APPROVAL=true
# Index vectors and rollback checkpoints.
CA_DATA_DIR=code_assistant/data
# Set to false to serve only the JSON/SSE API (no Gradio UI).
CA_UI_ENABLED=true

# --- Stock Finder (stock_finder/) — AI equity research; never places trades ---
# Uses OPENAI_API_KEY above. Own MongoDB database for holdings and audited reports;
# SF_MONGODB_URI falls back to MONGODB_URI when unset.
# SF_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stock_research
SF_MONGODB_DB_NAME=stock_research
SF_ROUTER_MODEL=gpt-4o-mini
SF_ANALYST_MODEL=gpt-4o
# Per-company analysis workers.
SF_WORKER_MODEL=gpt-4o-mini
# Must differ from SF_ANALYST_MODEL (startup fails if they are equal). o3-mini is deprecated by OpenAI.
SF_CRITIC_MODEL=gpt-4.1
SF_FALLBACK_MODEL=gpt-4o-mini
SF_EMBEDDING_MODEL=text-embedding-3-small
# IN (NSE/BSE, ".NS" suffix, SEBI disclaimer) or US.
SF_MARKET=IN
SF_MARKET_DATA_PROVIDER=yfinance
# rss feeds come from config/stock_finder_feeds.yaml; newsapi needs NEWSAPI_KEY.
SF_NEWS_PROVIDERS=rss,newsapi
# NEWSAPI_KEY=
SF_MAX_CANDIDATES=8
SF_MAX_PARALLEL_WORKERS=4
SF_NEWS_LOOKBACK_DAYS=7
# Hard cap on LLM calls per request; the run stops cleanly with partial results.
SF_MAX_LLM_CALLS=60
SF_RISK_PROFILE_DEFAULT=moderate
SF_URL_PREFIX=/stock-finder
# Concentration warnings (percent of portfolio).
SF_MAX_STOCK_PCT=25
SF_MAX_SECTOR_PCT=40
# Optional JSON override of composite-score weights per risk profile, e.g.
# SF_SCORE_WEIGHTS={"moderate": {"fundamentals": 0.3, "valuation": 0.2, "momentum": 0.2, "news_sentiment": 0.15, "risk": 0.15}}
# Set to false to serve only the JSON/SSE API (no Gradio UI).
SF_UI_ENABLED=true
